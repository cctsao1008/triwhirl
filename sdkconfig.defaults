CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n

# TriWhirl is a hard realtime control workload. Use the ESP-IDF performance
# optimization profile (-O2) rather than the default debug-oriented -Og build.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# CONFIG_COMPILER_OPTIMIZATION_DEBUG is not set

# Keep the realtime control path within the 1 kHz budget on ESP32-WROOM-32.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# Do not permit dynamic CPU/APB frequency scaling or automatic light sleep in
# the realtime firmware. ESP-IDF documents extra interrupt latency when power
# management is enabled; TriWhirl prefers fixed clocks and deterministic timing.
# CONFIG_PM_ENABLE is not set

# ESP32-WROOM-32 module flash geometry and dedicated raw binary logger region.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Keep the UART console focused on TriWhirl's own bring-up shell.
# Normal ESP-IDF boot/application chatter is suppressed; errors remain visible.
CONFIG_BOOTLOADER_LOG_LEVEL_ERROR=y
CONFIG_LOG_DEFAULT_LEVEL_ERROR=y

# Native BLE-only transport for Web Bluetooth.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_GATT_CLIENT=n
CONFIG_BT_NIMBLE_GATT_SERVER=y
CONFIG_BT_NIMBLE_PINNED_TO_CORE_0=y
